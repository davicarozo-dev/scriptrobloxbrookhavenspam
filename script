local botoesMobile = {}

local function criarBotoesMobile()

	for _, objeto in pairs(botoesMobile) do
		if objeto then
			objeto:Destroy()
		end
	end

	botoesMobile = {}

	for indice, config in ipairs(mensagens) do

		local botao = Instance.new("TextButton")
		botao.Name = "Mensagem_" .. indice
		botao.Size = UDim2.new(0, 60, 0, 60)

		local coluna = (indice - 1) % 4
		local linha = math.floor((indice - 1) / 4)

		botao.Position = UDim2.new(
			0,
			20 + coluna * 70,
			1,
			-90 - linha * 70
		)

		botao.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
		botao.Text = config.emoji ~= "" and config.emoji or "💬"
		botao.TextSize = 28
		botao.TextColor3 = Color3.new(1, 1, 1)
		botao.Parent = mobileFrame

		arredondar(botao, 100)

		botoesMobile[config] = botao
		arrastavel(botao, botao)
		botao.MouseButton1Down:Connect(function()

			if enviando[config] then
				return
			end

			enviando[config] = true

			task.spawn(function()

				while enviando[config] do

					local canal = TextChatService.TextChannels:FindFirstChild("RBXGeneral")

					if canal then
						pcall(function()
							canal:SendAsync(config.texto)
						end)

						contador += 1
					end

					task.wait(config.intervalo)
				end

			end)
		end)

		botao.MouseButton1Up:Connect(function()
			enviando[config] = false
		end)
		botao.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				enviando[config] = false
			end
		end)
	end
end


