--==================================================
-- FUNÇÕES VISUAIS
--==================================================

local function arredondar(obj, raio)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, raio)
	corner.Parent = obj
	return corner
end

local function criarStroke(obj, transparencia)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(90, 90, 90)
	stroke.Transparency = transparencia or 0.35
	stroke.Thickness = 1
	stroke.Parent = obj
	return stroke
end

--==================================================
-- SISTEMA DE ARRASTAR
--==================================================

local function arrastavel(obj, area, somenteEditor)
	local arrastando = false
	local inicio
	local posicao

	area.InputBegan:Connect(function(input)

		if somenteEditor and not modoEditor then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			arrastando = true
			inicio = input.Position
			posicao = obj.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					arrastando = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)

		if not arrastando then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - inicio

			obj.Position = UDim2.new(
				posicao.X.Scale,
				posicao.X.Offset + delta.X,
				posicao.Y.Scale,
				posicao.Y.Offset + delta.Y
			)
		end
	end)
end

--==================================================
-- TECLAS
--==================================================

local function keyCodeDaLetra(letra)

	letra = string.upper(letra or "")

	if #letra ~= 1 then
		return nil
	end

	return Enum.KeyCode[letra]
end

--==================================================
-- CANAL
--==================================================

local function enviarMensagem(texto)

	local canal = TextChatService.TextChannels:FindFirstChild("RBXGeneral")

	if not canal then
		return false
	end

	local sucesso = pcall(function()
		canal:SendAsync(texto)
	end)

	return sucesso
end

