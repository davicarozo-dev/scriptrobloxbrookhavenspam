--==================================================
-- CRIAR BOTÕES MOBILE
--==================================================

local function criarBotoesMobile()

	for _, objeto in pairs(botoesMobile) do
		if objeto then
			objeto:Destroy()
		end
	end

	botoesMobile = {}

	for indice, config in ipairs(mensagens) do

		local botao = Instance.new("TextButton")
		botao.Name = "Mensagem_" .. indice
		botao.Size = UDim2.new(0, 62, 0, 62)

		local coluna = (indice - 1) % 4
		local linha = math.floor((indice - 1) / 4)

		botao.Position = UDim2.new(
			0,
			20 + coluna * 72,
			1,
			-90 - linha * 72
		)

		botao.BackgroundColor3 = Color3.fromRGB(52, 52, 55)
		botao.Text = config.emoji ~= "" and config.emoji or "💬"
		botao.TextSize = 28
		botao.TextColor3 = Color3.new(1, 1, 1)
		botao.Parent = mobileFrame

		arredondar(botao, 100)
		criarStroke(botao)

		botoesMobile[config] = botao

		-- SÓ permite arrastar no Modo Editor
		arrastavel(botao, botao, true)

		-- COMEÇAR
		botao.InputBegan:Connect(function(input)

			if modoEditor then
				return
			end

			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then

				if enviando[config] then
					return
				end

				enviando[config] = true

				task.spawn(function()

					while enviando[config] and not modoEditor do

						if enviarMensagem(config.texto) then
							contador += 1
						end

						task.wait(config.intervalo)
					end

				end)
			end
		end)

		-- PARAR
		botao.InputEnded:Connect(function(input)

			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then

				enviando[config] = false
			end
		end)
	end
end

