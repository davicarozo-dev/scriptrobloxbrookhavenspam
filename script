--==================================================

salvarPreset.MouseButton1Click:Connect(function()

	local nome = presetNome.Text

	if nome == "" then
		presetStatus.Text = "❌ Digite um nome para o preset."
		return
	end

	local dados = {}

	for _, config in ipairs(mensagens) do

		table.insert(dados, {
			nomeTecla = config.nomeTecla,
			texto = config.texto,
			intervalo = config.intervalo,
			emoji = config.emoji
		})

	end

	presets[nome] = dados

	presetStatus.Text = "✅ Preset '" .. nome .. "' salvo!"

end)

--==================================================
-- CARREGAR PRESET
--==================================================

carregarPreset.MouseButton1Click:Connect(function()

	local nome = presetNome.Text

	if nome == "" then
		presetStatus.Text = "❌ Digite o nome do preset."
		return
	end

	local dados = presets[nome]

	if not dados then
		presetStatus.Text = "❌ Preset não encontrado."
		return
	end

	pararTodos()

	table.clear(mensagens)

	for _, config in ipairs(dados) do

		local key = keyCodeDaLetra(config.nomeTecla)

		if key then

			table.insert(mensagens, {
				tecla = key,
				nomeTecla = config.nomeTecla,
				texto = config.texto,
				intervalo = config.intervalo,
				emoji = config.emoji
			})

		end
	end

	atualizarLista()
	criarBotoesMobile()

	presetStatus.Text = "✅ Preset '" .. nome .. "' carregado!"

end)

