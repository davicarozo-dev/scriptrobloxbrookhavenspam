UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or modo ~= "PC" then
		return
	end
	for _, config in ipairs(mensagens) do

		if input.KeyCode == config.tecla and not enviando[config] then

			enviando[config] = true

			task.spawn(function()

				while enviando[config] and modo == "PC" do

					local canal = TextChatService.TextChannels:FindFirstChild("RBXGeneral")

					if canal then

						pcall(function()
							canal:SendAsync(config.texto)
						end)

						contador += 1
