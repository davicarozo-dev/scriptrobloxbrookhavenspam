--==================================================
-- TECLAS PC
--==================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)

	if gameProcessed then
		return
	end

	if modo ~= "PC" then
		return
	end

	if modoEditor then
		return
	end

	for _, config in ipairs(mensagens) do

		if input.KeyCode == config.tecla
			and not enviando[config] then

			enviando[config] = true

			task.spawn(function()

				while enviando[config]
					and modo == "PC"
					and not modoEditor do

					if enviarMensagem(config.texto) then
						contador += 1
					end

					task.wait(config.intervalo)
				end

			end)
		end
	end
end)

--==================================================
-- SOLTAR TECLA
--==================================================

UserInputService.InputEnded:Connect(function(input)

	for _, config in ipairs(mensagens) do

		if input.KeyCode == config.tecla then
			enviando[config] = false
		end

	end
end)

