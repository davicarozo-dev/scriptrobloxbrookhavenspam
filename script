salvarMensagem.MouseButton1Click:Connect(function()

	local key = keyCodeDaLetra(campoTecla.Text)

	if not key then
		campoTecla.Text = ""
		campoTecla.PlaceholderText = "Tecla inválida!"
		return
	end

	if campoMensagem.Text == "" then
		return
	end

	local tempo = tonumber(campoIntervalo.Text)

	if not tempo or tempo < 0.1 then
		tempo = 0.1
	end

	local dados = {
		tecla = key,
		nomeTecla = string.upper(campoTecla.Text),
		texto = campoMensagem.Text,
		intervalo = tempo,
		emoji = campoEmoji.Text ~= "" and campoEmoji.Text or "💬"
	}

	if editandoIndice then

		enviando[mensagens[editandoIndice]] = false
		mensagens[editandoIndice] = dados

	else

		table.insert(mensagens, dados)

	end

	editor.Visible = false

	atualizarLista()
	criarBotoesMobile()
end)

