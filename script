--==================================================
-- SALVAR MENSAGEM
--==================================================

salvarMensagem.MouseButton1Click:Connect(function()

	local nomeTecla = string.upper(campoTecla.Text)
	local key = keyCodeDaLetra(nomeTecla)

	if not key then

		campoTecla.Text = ""
		campoTecla.PlaceholderText = "❌ Tecla inválida!"

		return
	end

	if campoMensagem.Text == "" then
		return
	end

	local tempo = tonumber(campoIntervalo.Text)

	if not tempo or tempo < 0.1 then
		tempo = 0.1
	end

	local texto = campoMensagem.Text

	-- DUPLICATA
	for indice, config in ipairs(mensagens) do

		if indice ~= editandoIndice
			and config.tecla == key
			and string.lower(config.texto) == string.lower(texto) then

			campoMensagem.Text = ""
			campoMensagem.PlaceholderText = "❌ Essa mensagem já existe!"

			return
		end
	end

	local dados = {
		tecla = key,
		nomeTecla = nomeTecla,
		texto = texto,
		intervalo = tempo,
		emoji = campoEmoji.Text ~= "" and campoEmoji.Text or "💬"
	}

	if editandoIndice then

		enviando[mensagens[editandoIndice]] = false
		mensagens[editandoIndice] = dados

	else

		table.insert(mensagens, dados)
	end

	editor.Visible = false

	atualizarLista()
	criarBotoesMobile()
end)

